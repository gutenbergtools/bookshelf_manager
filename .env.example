DJANGO_SECRET_KEY=change-me-to-50-random-chars
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=catalog.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://catalog.example.org
DJANGO_SECURE_COOKIES=1
DJANGO_LOG_LEVEL=INFO
DJANGO_SESSION_AGE=43200
DJANGO_DB_PATH=/var/lib/catalog_manager/auth.sqlite3
DJANGO_ADMIN_URL=admin
DJANGO_TIME_ZONE=America/New_York

PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=gutenberg
PGUSER=gutenberg
# PGPASSWORD=  # optional; libpq also reads ~/.pgpass
# PGSSLMODE=require

CATALOG_PAGE_SIZE=50
CATALOG_HIT_PAGE_SIZE=8
CATALOG_RATE_LOGIN=10/m
CATALOG_RATE_POST=60/m
CATALOG_RATE_JOBS=30/m
JOBS_API_TOKEN=change-me-jobs-token
CATALOG_TRUSTED_PROXIES=127.0.0.1,::1
CATALOG_CATALOGERS=cataloger@example.org
# CATALOG_REVIEWERS=  # extra cataloger emails
