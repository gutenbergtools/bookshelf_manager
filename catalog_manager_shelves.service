[Unit]
Description=Catalog Manager (shelves volunteer UI)
After=network.target postgresql.service

[Service]
User=catalog
Type=simple
RuntimeDirectory=catalog_manager_shelves
WorkingDirectory=/var/lib/catalog_manager
EnvironmentFile=-/var/lib/catalog_manager/.env.shelves
Environment=CATALOG_APP=shelves
ExecStartPre=-/usr/bin/mkdir -p /var/run/catalog_manager_shelves
ExecStart=/var/lib/catalog_manager/.venv/bin/gunicorn \
    --bind 127.0.0.1:8001 \
    --workers 2 \
    catalog.wsgi:application
LimitNOFILE=infinity

[Install]
WantedBy=multi-user.target
