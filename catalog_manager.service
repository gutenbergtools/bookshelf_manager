[Unit]
Description=Catalog Manager (cataloger UI)
After=network.target postgresql.service

[Service]
User=catalog
Type=simple
RuntimeDirectory=catalog_manager
WorkingDirectory=/var/lib/catalog_manager
EnvironmentFile=-/var/lib/catalog_manager/.env
ExecStartPre=-/usr/bin/mkdir -p /var/run/catalog_manager
ExecStart=/var/lib/catalog_manager/.venv/bin/gunicorn \
    --bind 127.0.0.1:8000 \
    --workers 2 \
    catalog.wsgi:application
LimitNOFILE=infinity

[Install]
WantedBy=multi-user.target
